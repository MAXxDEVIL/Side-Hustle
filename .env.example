# Copy to .env. Leave Twilio blank to run fully offline in mock mode.
PORT=8787
PUBLIC_URL=http://localhost:8787

# Twilio (Phase 1+). Without these the server runs in mock mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Local open-weight model (Phase 2+)
OLLAMA_URL=http://localhost:11434
MODEL=gemma3:4b

# Owner alerts + review page
OWNER_PHONE=
# Required in every mode (mock included). Leave blank and the server mints one
# each run and prints the /admin link; set it to keep that link stable.
ADMIN_TOKEN=
# Blunt abuse protection and a local record of every model call.
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=60000
LOG_FILE=triage.log
BUSINESS_FILE=business.json
DB_FILE=second-ring.db
MAX_TURNS=8
